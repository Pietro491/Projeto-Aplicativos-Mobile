import React from 'react';
import { View, Text, StyleSheet, FlatList, Button } from 'react-native';

import { NavigationContainer } from '@react-navigation/native';
import { createNativeStackNavigator } from '@react-navigation/native-stack';

const Stack = createNativeStackNavigator();

// Lista de filmes
const filmes = [
  { id: '1', titulo: 'Interestelar', genero: 'Ficção Científica' },
  { id: '2', titulo: 'Homem-Aranha', genero: 'Ação' },
  { id: '3', titulo: 'Toy Story', genero: 'Animação' },
  { id: '4', titulo: 'Vingadores', genero: 'Ação' },
  { id: '5', titulo: 'O Rei Leão', genero: 'Animação' },
];

// Função para renderizar cada filme
function renderFilme({ item }) {
  return (
    <View style={styles.item}>
      <Text style={styles.titulo}>{item.titulo}</Text>
      <Text>Gênero: {item.genero}</Text>
    </View>
  );
}

// Tela inicial
function HomeScreen({ navigation }) {
  
  // Função para navegar para a tela de filmes
  function abrirFilmes() {
    navigation.navigate('Filmes');
  }

  return (
    <View style={styles.container}>
      <Text style={styles.header}>
        🎬 Meu Aplicativo de Filmes
      </Text>

      <Text style={styles.texto}>
        Bem-vindo ao aplicativo!
      </Text>

      <Button
        title="Ver filmes"
        onPress={abrirFilmes}
      />
    </View>
  );
}

// Tela que contém a FlatList
function FilmesScreen() {

  return (
    <View style={styles.container}>
      <Text style={styles.header}>
        Lista de Filmes
      </Text>

      <FlatList
        data={filmes}
        keyExtractor={(item) => item.id}
        renderItem={renderFilme}
      />
    </View>
  );
}

// Navegação
export default function App() {
  return (
    <NavigationContainer>

      <Stack.Navigator>

        <Stack.Screen
          name="Home"
          component={HomeScreen}
          options={{ title: 'Início' }}
        />

        <Stack.Screen
          name="Filmes"
          component={FilmesScreen}
          options={{ title: 'Filmes' }}
        />

      </Stack.Navigator>

    </NavigationContainer>
  );
}

// Estilos
const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 20,
    justifyContent: 'center',
  },

  header: {
    fontSize: 25,
    fontWeight: 'bold',
    marginBottom: 20,
    textAlign: 'center',
  },

  texto: {
    fontSize: 18,
    textAlign: 'center',
    marginBottom: 20,
  },

  item: {
    padding: 20,
    marginBottom: 10,
    backgroundColor: '#eeeeee',
    borderRadius: 10,
  },

  titulo: {
    fontSize: 20,
    fontWeight: 'bold',
    marginBottom: 5,
  },
});